{
  "name": "dsh-wb2api-panel",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "WorkBuddy2API 网关的管理面板与进程托管，把 workbuddy2api-panel 作为 DSH 插件使用。",
  "engines": { "node": ">=22.18.0", "dsh": ">=0.2.0-rc.1" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
